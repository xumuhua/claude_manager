# MON1 监测件可调项（拷成 monitor.env 放同目录，systemd EnvironmentFile 会吃）
# 本文件不含任何密钥；告警 token 走 /home/manager/keys/rotator-alert.env（与 rotator 共用）
# 改完 systemctl restart litellm-monitor 生效

# 探测间隔秒（4 上游 × 每轮 8~62 input tokens，一天约 1.2 万 token）
MON_INTERVAL_S=300

# 瞬态错（超时/5xx/限流）连续几次才认定+告警；确定性错（403-额度/401/缺 key）一次即认定
MON_FAIL_THRESHOLD=2

# 单发探测超时秒
MON_PROBE_TIMEOUT_S=25

# probe 明细保留天数（每小时清一次）
MON_KEEP_DAYS=14

# 告警会话与前缀（hub 配置里没有 dm_yifei，coder↔yifei 的信道就是 dm_coder）
MON_ALERT_CONV=dm_coder
MON_ALERT_TAG=[模型监测]

# rotator 预期轮转间隔（分钟），超 1.5× 未轮转报「轮转停摆」
MON_ROTATE_EXPECT_MIN=177

# MON1-AWARE1（2026-10-14，亦菲 seq 3387）：轮转停摆检测感知 v2.4 静默窗 defer——
# 到点轮转被 BLACKOUT/在飞长流 defer 押后属设计内避让，不是停摆，不告警；
# 真停摆鉴别=「defer 心跳断+无 ROTATE」（daemon 死时心跳会断）。0 = 回滚旧判据
MON_DEFER_AWARE=1
# defer 心跳新鲜窗秒（rotator DEFER_BEAT_S=900 + 裕量）
MON_DEFER_FRESH_S=1200
# BLACKOUT until 到期后的落地复检宽限秒 / INFLIGHT cap 判定同源 rotator DEFER_MAX_S
MON_DEFER_UNTIL_GRACE_S=300
MON_DEFER_INFLIGHT_CAP_S=3600

# 链头切换告警降噪（2026-10-13 落地，亦菲 seq 3086 批准）：rotator ~176min 一轮
# 属设计内行为，逐条告警一天 ~8 条信息密度低 → 默认改 24h 一条日汇总；
# 0 = 回滚到逐条告警（旧行为）
MON_HEADSWITCH_DAILY=1
# 日汇总最小间隔小时数
MON_HEADSWITCH_DIGEST_H=24

# 经中转站的端到端探测：默认关（会落 spendlogs 行+可能触发 cooldown；
# 中转站本体故障已由 /health/liveliness 那一路覆盖）
MON_E2E=0

# rotator 维护的浮动入口别名（不当探测目标，只登记指向）
MON_ENTRY_ALIAS=kimi-han
