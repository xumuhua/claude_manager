/* 全局样式：配色走 theme.json 变量（深/浅色跟随系统，D1 §8.1） */
page {
  background: var(--bg);
  color: var(--fg);
  font-size: 15px;
  line-height: 1.65;
}

/* MP-TABBAR-TOP（哥哥 10/9 令，亦菲 seq 2692）：tabBar 底部→顶部。
   custom tabBar 组件 fixed 钉顶（app.json tabBar.custom:true 的微信强制形态），
   全局统一给 page 垫「tabBar 高（48px）+状态栏安全区（env(safe-area-inset-top)）」——
   页面内容区结构化让位、顶部 tabBar 永不遮挡内容，各页不再逐页手写 tabBar 垫顶。
   底部从此零叠压：各页 fixed 底栏（chat dock / 报告页 input-bar）回 bottom:0
   贴屏幕底+env(safe-area-inset-bottom)（键盘弹起微信整体上移，fixed 底栏贴
   键盘顶，不再与任何原生 chrome 叠压）——底部遮挡问题从根上消灭。
   非 tab 页（login/repo tree/doc/experts）多垫 48px+安全区无碍视觉，一并统一。
   沿革：94d7d39 抬底栏 → 68f7115 垫底移交（误诊 fixed 不吃 padding）
   → c1eff02 双轨并存 → 本单整体翻转到顶部，双轨自然塌缩为单轨。 */
page {
  padding-top: calc(48px + env(safe-area-inset-top));
  box-sizing: border-box;
}
.bg2 { background: var(--bg2); }
.fg2 { color: var(--fg2); }
.primary { color: var(--primary); }
.err { color: var(--err); }

/* 弱提示条 */
.banner-warn {
  background: var(--warn-bg); color: var(--warn-fg);
  font-size: 12px; padding: 4px 16px; text-align: center;
}
.banner-err {
  background: var(--err); color: #fff;
  font-size: 12px; padding: 4px 16px; text-align: center;
}

/* 骨架屏 */
.skel {
  height: 18px; border-radius: 4px; margin: 10px 16px;
  background: var(--bg2);
}
