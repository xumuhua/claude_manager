/* 全局样式：配色走 theme.json 变量（深/浅色跟随系统，D1 §8.1） */
page {
  background: var(--bg);
  color: var(--fg);
  font-size: 15px;
  line-height: 1.65;
}

/* MP-TABBAR-EMBED（哥哥 10/8 令，亦菲 seq 2681）：tabBar 悬浮→固定嵌入。
   custom tabBar 组件仍 fixed 钉底（app.json tabBar.custom:true 的微信强制形态），
   但全局统一给 page 垫「tabBar 高（48px）+iPhone 安全区」——页面内容区结构化
   让位、tabBar 永不遮挡内容，各页不再逐页手写 tabBar 垫底；
   各页 fixed 底栏（chat dock / 报告页 input-bar）回归 bottom:0 即贴 tabBar 上沿。
   非 tab 页（login/repo tree/doc/experts）多垫 48px+安全区无碍视觉，一并统一。 */
page {
  padding-bottom: calc(48px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.bg2 { background: var(--bg2); }
.fg2 { color: var(--fg2); }
.primary { color: var(--primary); }
.err { color: var(--err); }

/* 弱提示条 */
.banner-warn {
  background: var(--warn-bg); color: var(--warn-fg);
  font-size: 12px; padding: 4px 16px; text-align: center;
}
.banner-err {
  background: var(--err); color: #fff;
  font-size: 12px; padding: 4px 16px; text-align: center;
}

/* 骨架屏 */
.skel {
  height: 18px; border-radius: 4px; margin: 10px 16px;
  background: var(--bg2);
}
