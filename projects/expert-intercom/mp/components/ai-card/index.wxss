.ai-card {
  background: var(--ai-bg);
  border-left: 3px solid var(--ai-bar);
  border-radius: 8px;
  margin: 8px 16px;
  padding: 10px 12px;
}
.ai-head { display: flex; justify-content: space-between; align-items: baseline; }
.ai-title { font-size: 14px; font-weight: 600; color: var(--ai-fg); }
.ai-badge { font-size: 10px; color: var(--ai-fg); opacity: 0.8; }
.ai-disclaimer { font-size: 10px; color: var(--fg2); margin: 2px 0 6px; }
.ai-point, .ai-mention { display: flex; flex-wrap: wrap; padding: 3px 0; font-size: 14px; line-height: 1.6; }
.ai-no { color: var(--ai-fg); margin-right: 6px; }
.ai-ptext { color: var(--fg); }
.ai-src { font-size: 10px; color: var(--fg2); margin-left: 4px; align-self: center; }
.ai-mention-bar { color: var(--atme-bar); margin-right: 2px; }
.ai-err { font-size: 13px; color: var(--fg2); padding: 8px 0; }
.ai-ops { display: flex; justify-content: flex-end; margin-top: 6px; }
.ai-op { font-size: 12px; color: var(--primary); margin-left: 16px; }
.ai-body .skel { margin: 6px 0; }
/* 组件样式隔离，骨架条样式本地自带（全局 .skel 不穿透组件） */
.skel { height: 16px; border-radius: 4px; background: var(--bg2); }
