/* custom-tab-bar — MP-STAT1 动态页签样式
   背景色由 js 注入实色 HEX（深浅双态），这里只管布局。
   MP-TABBAR-TOP（哥哥 10/9 令，亦菲 seq 2692）：组件钉顶（position:fixed top:0），
   顶部状态栏安全区让位（env(safe-area-inset-top)，老基础库退化 0 仍可用）；
   边框线下移到底缘（钉顶后分隔线贴内容区上沿）。「不遮内容」语义由 app.wxss
   全局 page 垫顶（48px+安全区）实现——底部从此零叠压。 */
.tab-bar {
  display: flex;
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  height: calc(48px + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
  border-bottom: 1rpx solid #E5E5EA;
  z-index: 9999;
}
.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-text {
  font-size: 11px;
  line-height: 1.4;
  white-space: nowrap;
}
.tab-text.on {
  font-weight: 600;
}

/* 深色态边框线（实色，不走 var） */
@media (prefers-color-scheme: dark) {
  .tab-bar { border-bottom-color: #2C2C2E; }
}
