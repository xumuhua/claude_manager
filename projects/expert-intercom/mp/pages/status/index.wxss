/* pages/status — MP-STAT1 状态页样式
   MP-UX7 教训红线：卡片/横幅背景一律实色 HEX + @media 双态，禁 var() 背景；
   文字色走 var 无妨。三态点由 emoji 自带色，不另配色。 */
.page { min-height: 100vh; padding-bottom: calc(60px + env(safe-area-inset-bottom)); }

/* 子页签分段器（浅色底实色） */
.seg {
  display: flex;
  margin: 10px 12px 4px;
  border-radius: 8px;
  background: #F7F7F8;            /* = --bg2 浅态值写死 */
  overflow: hidden;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 13px;
  padding: 7px 0;
  color: var(--fg2);
}
.seg-item.on {
  color: var(--primary);
  font-weight: 600;
  background: #FFFFFF;
}
@media (prefers-color-scheme: dark) {
  .seg { background: #1C1C1E; }
  .seg-item.on { background: #2C2C2E; }
}

/* 卡片（MP-DASH1 同款骨架） */
.card {
  margin: 10px 12px;
  border-radius: 10px;
  padding: 10px 12px;
  background: #F7F7F8;            /* 浅色实色（= --bg2 浅态值写死） */
}
@media (prefers-color-scheme: dark) {
  .card { background: #1C1C1E; }
}
.card-head { display: flex; align-items: center; margin-bottom: 6px; flex-wrap: wrap; }
.card-name { font-size: 15px; font-weight: 600; margin-right: 8px; color: var(--fg); }
.card-host { font-size: 11px; color: var(--fg2); margin-right: 8px; }
.fw-dot { font-size: 13px; margin-right: 6px; }
.fw-label { font-size: 12px; color: var(--fg2); }
.fw-label.fw-stale { color: var(--atme-bar); }
.fw-label.fw-down { color: var(--err); }

/* 指标网格 */
.grid { display: flex; flex-wrap: wrap; }
.cell { width: 50%; box-sizing: border-box; padding: 4px 8px 4px 0; }
.cell-k { display: block; font-size: 11px; color: var(--fg2); }
.cell-v { display: block; font-size: 13px; color: var(--fg); line-height: 1.5; }
.cell-pct { font-size: 10px; color: var(--fg2); }

/* 用量条 */
.bar {
  height: 4px;
  border-radius: 2px;
  background: #E5E5EA;            /* 浅色实色轨道 */
  margin: 3px 0 1px;
  overflow: hidden;
}
.bar-in {
  height: 100%;
  border-radius: 2px;
  background: var(--primary);
}
.bar-in.hot { background: var(--err); }   /* ≥85% 变红 */

/* 页脚明细 */
.foot { margin-top: 6px; padding-top: 6px; border-top: 1rpx solid var(--divider); font-size: 11px; line-height: 1.7; }
.foot-k { color: var(--fg2); margin-right: 6px; }
.foot-k2 { margin-left: 10px; }
.foot-v { color: var(--fg2); }

/* 模型区 */
.row { display: flex; margin-top: 4px; align-items: flex-start; }
.row-k { flex-shrink: 0; width: 60px; font-size: 12px; color: var(--fg2); line-height: 1.8; }
.row-v { flex: 1; font-size: 13px; line-height: 1.8; color: var(--fg); }
.row-v.emph { font-weight: 600; color: var(--primary); }
.chip {
  display: inline-block;
  font-size: 11px;
  padding: 1px 8px;
  margin: 0 6px 4px 0;
  border-radius: 9px;
  background: #EFEFEF;            /* 浅色实色（= --sys-bg 浅态值） */
  color: var(--fg2);
}
.chip-on { background: #E0ECFF; color: var(--primary); font-weight: 600; }   /* = --mention-bg 浅态值 */
@media (prefers-color-scheme: dark) {
  .chip { background: #2C2C2E; }
  .chip-on { background: #1E3A5F; }
}
.chain { font-size: 12px; color: var(--fg2); word-break: break-all; }

/* 横幅（实色，MP-UX7 红线） */
.banner-warn {
  margin: 8px 12px;
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 12px;
  background: #FEF3C7;            /* = --warn-bg 浅态值写死 */
  color: var(--warn-fg);
}
@media (prefers-color-scheme: dark) {
  .banner-warn { background: #3D2E06; }
}
.banner-err {
  margin: 8px 12px;
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 12px;
  background: #FEE2E2;
  color: var(--err);
}
@media (prefers-color-scheme: dark) {
  .banner-err { background: #3B1517; }
}

.meta-line { font-size: 11px; color: var(--fg2); padding: 4px 16px; text-align: center; }
.empty { text-align: center; color: var(--fg2); font-size: 13px; padding: 32px; }
.empty-inline { text-align: center; color: var(--fg2); font-size: 12px; padding: 8px 0 2px; }
