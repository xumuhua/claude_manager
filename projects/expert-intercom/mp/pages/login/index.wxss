/* pages/login — F7 登录页（配色走 theme.json 变量，深/浅跟随系统） */
.login-wrap {
  padding: 160rpx 48rpx 0;
  display: flex;
  flex-direction: column;
}
.logo {
  font-size: 56rpx;
  font-weight: 600;
  text-align: center;
}
.subtitle {
  font-size: 26rpx;
  text-align: center;
  margin: 16rpx 0 64rpx;
}
.form {
  border-radius: 16rpx;
  padding: 0 32rpx;
}
.field {
  height: 96rpx;
  font-size: 30rpx;
  color: var(--fg);
}
.ph { color: var(--fg2); }
.divider { height: 1px; background: var(--divider); }
.err-msg {
  font-size: 26rpx;
  margin: 24rpx 8rpx 0;
}
/* MP-BTN1（哥哥 10/9 实测「输入账密后按钮消失」，亦菲 seq 2790）：登录按钮
   背景【实色 HEX 直写，不走 var(--primary)】——theme.json 变量在 fixed/float
   态（键盘弹起悬浮）+真机深色/部分机型下背景解析渲染丢失（MP-UX7 红线病史，
   chat 顶栏 M3 先例），白底白字看起来像消失。深浅两态各自写死实色
   （浅色 #2563EB / 深色 #60A5FA = theme.json 两态 --primary 值）。 */
.login-btn {
  margin-top: 48rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: #2563EB;
  color: #fff;
  opacity: 0.45;               /* 账密未填齐：主色淡显，仍可一眼定位 */
}
.login-btn[disabled] {         /* 覆盖微信 button 默认 disabled 灰底 */
  background: #2563EB;
  color: #fff;
  opacity: 0.45;
}
.login-btn.ready,
.login-btn.ready[disabled] {   /* 可点 / 登录中：满主色 */
  opacity: 1;
}
.login-btn.float {             /* 键盘弹起：悬浮键盘顶，左右与表单对齐 */
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  margin-top: 0;
  z-index: 10;
}
.login-btn::after { border: none; }
/* MP-BTN1：深色态实色兜底（@media 仅命中深色，不扰浅色） */
@media (prefers-color-scheme: dark) {
  .login-btn,
  .login-btn[disabled] { background: #60A5FA; }
}
