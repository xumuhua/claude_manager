/* pages/login — F7 登录页（配色走 theme.json 变量，深/浅跟随系统） */
.login-wrap {
  padding: 160rpx 48rpx 0;
  display: flex;
  flex-direction: column;
}
.logo {
  font-size: 56rpx;
  font-weight: 600;
  text-align: center;
}
.subtitle {
  font-size: 26rpx;
  text-align: center;
  margin: 16rpx 0 64rpx;
}
.form {
  border-radius: 16rpx;
  padding: 0 32rpx;
}
.field {
  height: 96rpx;
  font-size: 30rpx;
  color: var(--fg);
}
.ph { color: var(--fg2); }
.divider { height: 1px; background: var(--divider); }
.err-msg {
  font-size: 26rpx;
  margin: 24rpx 8rpx 0;
}
.login-btn {
  margin-top: 48rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: var(--primary);
  color: #fff;
  opacity: 0.45;               /* 账密未填齐：主色淡显，仍可一眼定位 */
}
.login-btn[disabled] {         /* 覆盖微信 button 默认 disabled 灰底 */
  background: var(--primary);
  color: #fff;
  opacity: 0.45;
}
.login-btn.ready,
.login-btn.ready[disabled] {   /* 可点 / 登录中：满主色 */
  opacity: 1;
}
.login-btn.float {             /* 键盘弹起：悬浮键盘顶，左右与表单对齐 */
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  margin-top: 0;
  z-index: 10;
}
.login-btn::after { border: none; }
