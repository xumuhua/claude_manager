<!-- pages/daily_report — MP-TABS-REPORT 日常报告页：报告区 / 私有群双视图 -->
<!-- MP-HIST2⑤（哥哥 10/9 原话）：15s 闲置判定扩为全屏交互事件——根节点
     bindtouchstart 挂 onPageTouch，屏幕任意按下/拖动起点都重置计时。
     MP-JANK1（哥哥 10/9 实测「按什么都没反应」）：catch→bind——catch 拦截
     touchstart 冒泡在本页与 scroll-x 日期条/深层级子元素的组合下会吞子元素
     tap（chat 页同改，bind 冒泡阶段照样到根，idle 复位语义不变） -->
<view class="page" bindtouchstart="onPageTouch">

  <!-- ============ 报告视图 ============ -->
  <block wx:if="{{mode === 'report'}}">

    <!-- 历史日期列表（MP-HIST1②，哥哥 10/9 令；MP-HIST2② 修正：无条件显示日期本身——
         不管有无报告都出页签，探测失败仅绿点不亮；日期按本地时区，纯日期文本） -->
    <scroll-view scroll-x class="date-strip" wx:if="{{dateList.length}}">
      <view class="date-strip-in">
        <view wx:for="{{dateList}}" wx:key="date"
              class="date-chip {{item.date === date ? 'cur' : ''}}"
              data-date="{{item.date}}" bindtap="pickDate">
          {{item.label}}<text wx:if="{{item.avail > 0}}" class="date-dot">·</text>
        </view>
        <view wx:if="{{!historyDone}}" class="date-chip more {{historyLoading ? 'off' : ''}}"
              bindtap="loadMoreHistory">{{historyLoading ? '加载中…' : '更早 7 天'}}</view>
      </view>
    </scroll-view>

    <!-- 报告概述卡片（当日三份；未产出/失败显示占位不报错） -->
    <view class="sec-title">📋 {{date}} 每日报告</view>
    <view wx:if="{{reportErr}}" class="banner-err">{{reportErr}}</view>
    <view wx:if="{{!reports.length && !reportErr}}" class="empty">加载中…</view>

    <view wx:for="{{reports}}" wx:key="key" class="card">
      <view class="card-head" data-key="{{item.key}}" bindtap="toggleReport">
        <text class="fw-dot">{{item.available ? '📄' : '⚪'}}</text>
        <text class="card-name">{{item.title}}</text>
        <text class="card-toggle">{{expanded[item.key] ? '收起 ▲' : (item.available ? '全文 ▼' : '')}}</text>
      </view>
      <view wx:if="{{item.available}}" class="rpt-summary">{{item.summary}}</view>
      <view wx:else class="rpt-none">{{item.note || '当日未产出'}}</view>
      <view wx:if="{{expanded[item.key] && mdBlocks[item.key]}}" class="rpt-md">
        <md-block blocks="{{mdBlocks[item.key]}}" />
      </view>
    </view>

    <!-- LLM 对话框（问报告细节；暗号口径哥哥 10/9 令④：明文提示撤出，只留问报告引导） -->
    <view class="sec-title">💬 问报告</view>
    <view wx:if="{{!chatMsgs.length}}" class="chat-hint">基于今日报告提问，例如「量化日报今天主线是什么」。</view>
    <view wx:for="{{chatMsgs}}" wx:key="index" class="chat-row {{item.role === 'user' ? 'me' : ''}}">
      <view class="chat-bubble {{item.role}}">{{item.text}}</view>
    </view>
    <view wx:if="{{sending}}" class="chat-hint">思考中…</view>
  </block>

  <!-- ============ 私有群视图（暗号 2505 进入） ============ -->
  <block wx:else>
    <view wx:if="{{pErr}}" class="banner-err">{{pErr}}</view>
    <view wx:if="{{!pMsgs.length && !pErr}}" class="empty">还没有消息，说点什么吧</view>
    <scroll-view scroll-y class="pg-scroll" scroll-into-view="{{pAnchor}}" scroll-with-animation>
      <view wx:for="{{pMsgs}}" wx:key="msg_id" class="chat-row {{item.mine ? 'me' : ''}}">
        <view class="pg-msg {{item.mine ? 'mine' : ''}}">
          <text class="pg-from">{{item.display || item.from}}</text>
          <text class="pg-body">{{item.body}}</text>
        </view>
      </view>
      <!-- 滚底锚点（scroll-into-view 锚末位） -->
      <view id="pg-last" class="pg-anchor"></view>
    </scroll-view>
  </block>

  <!-- 输入条（两视图共用；发送按 mode 分发） -->
  <view class="input-bar">
    <!-- 私有群视图：操作钮（登出小胶囊居左灰底 / 返回报告页在右）贴输入框上方
         MP-HIST1①（哥哥 10/9 原话：「不要太大有个就行，放在左边，用灰色的背景即可」） -->
    <view wx:if="{{mode === 'pgroup'}}" class="pg-actions">
      <view class="pg-action-mini" bindtap="onLogout">登出</view>
      <view class="pg-action-btn" bindtap="backToReport">← 返回报告页</view>
    </view>
    <view class="input-row">
      <input
        class="input"
        value="{{inputVal}}"
        placeholder="{{mode === 'pgroup' ? '发到私有群…' : '问报告细节…'}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="onSend"
        disabled="{{sending}}"
        adjust-position="{{true}}"
        cursor-spacing="12"
      />
      <view class="send-btn {{sending ? 'off' : ''}}" bindtap="onSend">发送</view>
    </view>
  </view>
</view>
