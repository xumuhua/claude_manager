/* pages/daily_report — MP-TABS-REPORT 日常报告页样式
   MP-UX7 红线：卡片/横幅/输入条背景一律实色 HEX + @media 双态，禁 var() 背景。 */
.page {
  /* 报告卡片是数据驱动列表（后端 reports 数组逐张渲染），三卡→四卡（MP-GOSSIP1
     gossip 娱乐吃瓜日报）不改结构只变长——min-height（非 height）+ 无 overflow
     裁剪 = 页面原生滚动承载任意张数卡片，布局自适应。 */
  min-height: 100vh;
  /* MP-TABBAR-EMBED（哥哥 10/8 令）：tabBar 位由全局 page 垫顶（app.wxss）覆盖，
     此处只让位输入条（含私有群操作钮行 44+8 + 输入行 ≈48 + padding 16 ≈116px 上限，
     取 72px 常态值+尾部余量；多行/操作钮行场景消息列尾部允许再滑入垫区）。
     MP-GOSSIP1（四卡后列表更长，尾卡被 fixed 输入条压住的概率上升）：垫底补
     env(safe-area-inset-bottom)——输入条 bottom 就是 env(...)（贴屏底只让 home
     indicator），全面屏上它实际占到距屏底 34+52px，旧 64px 定值盖不住尾卡。 */
  padding-bottom: calc(72px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sec-title { font-size: 13px; font-weight: 600; color: var(--fg2); margin: 14px 14px 2px; }

/* 历史日期横滚条（MP-HIST1② 哥哥 10/9 令）：小胶囊横排，选中高亮，「更早 7 天」续加 */
.date-strip { white-space: nowrap; margin: 8px 0 0; }
.date-strip-in { display: inline-flex; align-items: center; padding: 0 12px; }
.date-chip {
  display: inline-flex;
  align-items: center;
  height: 26px;
  padding: 0 10px;
  margin-right: 6px;
  border-radius: 13px;
  font-size: 12px;
  color: var(--fg2);
  background: #F7F7F8;
}
.date-chip.cur {
  color: #FFFFFF;
  background: #2563EB;
  font-weight: 600;
}
.date-chip.more { color: var(--primary); }
.date-chip.off { opacity: 0.5; }
.date-dot { color: #16A34A; margin-left: 2px; font-weight: 700; }
.date-chip.cur .date-dot { color: #BBF7D0; }
@media (prefers-color-scheme: dark) {
  .date-chip { background: #1C1C1E; }
}

/* 报告卡片（status/experts 同款骨架） */
.card {
  margin: 10px 12px;
  border-radius: 10px;
  padding: 10px 12px;
  background: #F7F7F8;
}
@media (prefers-color-scheme: dark) {
  .card { background: #1C1C1E; }
}
.card-head { display: flex; align-items: center; margin-bottom: 4px; }
.fw-dot { font-size: 13px; margin-right: 6px; }
.card-name { font-size: 15px; font-weight: 600; margin-right: 8px; color: var(--fg); flex: 1; }
.card-toggle { font-size: 11px; color: var(--primary); }
.rpt-summary { font-size: 12px; color: var(--fg2); line-height: 1.7; white-space: pre-wrap; }
.rpt-none { font-size: 12px; color: var(--fg2); padding: 4px 0; }
.rpt-md { margin-top: 8px; border-top: 1rpx solid var(--divider); padding-top: 8px; }

/* 对话框 */
.chat-hint { font-size: 11px; color: var(--fg2); padding: 8px 16px; }
.chat-row { display: flex; padding: 4px 12px; }
.chat-row.me { justify-content: flex-end; }
.chat-bubble {
  max-width: 78%;
  border-radius: 10px;
  padding: 8px 12px;
  font-size: 14px;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  background: #F7F7F8;
  color: var(--fg);
}
.chat-bubble.user { background: #E0ECFF; }
@media (prefers-color-scheme: dark) {
  .chat-bubble { background: #1C1C1E; }
  .chat-bubble.user { background: #1E3A5F; }
}

/* 私有群操作钮行：登出小胶囊居左灰底（MP-HIST1① 哥哥 10/9 原话「不要太大有个就行，
   放在左边，用灰色的背景即可」）+ 返回报告页在右（保持大按钮快速点击，哥哥 10/8 令） */
.pg-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 0 8px;
}
.pg-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 10px;
  color: var(--primary);
  background: #E0ECFF;
}
/* 登出小胶囊：固定小尺寸、灰底灰字不醒目（非红色 danger） */
.pg-action-mini {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 28px;
  padding: 0 12px;
  font-size: 12px;
  border-radius: 14px;
  color: #6B7280;
  background: #E5E7EB;
}
@media (prefers-color-scheme: dark) {
  .pg-action-btn { background: #1E3A5F; }
  .pg-action-mini { color: #9CA3AF; background: #374151; }
}

/* 私有群消息（哥哥 10/8 二令②：自己的消息靠右含名字，别人的靠左） */
/* MP-PGBG1（哥哥 10/9 给图，亦菲 seq 2795）：pg-scroll 消息区铺聊天背景
   assets/pgroup_bg.jpg。wxss background-image 不支持本地路径（真机不显示），
   用 image 组件铺底；背景层在 scroll-view 外层容器内（滚动时背景不动=不撕裂）。
   容器高度沿用 172px 扣减口径（MP-TABBAR-TOP 定型），scroll-view flex:1 撑满容器
   （min-height:0 防 flex 子项撑穿容器，MP-UX2 min-height:0 教训同源）。 */
.pg-bg-wrap {
  position: relative;
  height: calc(100vh - 172px);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.pg-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%; height: 100%;
  z-index: 0;
}
.pg-scroll { flex: 1; min-height: 0; }
.pg-anchor { height: 1px; }
.pg-msg { display: flex; flex-direction: column; max-width: 85%; }
.pg-msg.mine { align-items: flex-end; }
.pg-from { font-size: 11px; color: var(--fg2); margin-bottom: 2px; }
.pg-body {
  font-size: 14px; line-height: 1.6; color: var(--fg);
  background: #F7F7F8; border-radius: 10px; padding: 8px 12px;
  white-space: pre-wrap; word-break: break-word;
}
.pg-msg.mine .pg-body { background: #E0ECFF; }
@media (prefers-color-scheme: dark) {
  .pg-body { background: #1C1C1E; }
  .pg-msg.mine .pg-body { background: #1E3A5F; }
}
/* MP-PGBG1：背景图上浅色气泡边界模糊（浅奶油黄底 vs #F7F7F8 近白），加轻阴影
   撑出气泡轮廓（颜色不动=照亦菲口径②气泡底色保持现有实色） */
.pg-msg .pg-body { box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18); }

/* 输入条（fixed 贴屏幕底；实色背景；column 向容纳私有群操作钮行+输入行）
   MP-TABBAR-TOP（哥哥 10/9 令，亦菲 seq 2692）：tabBar 钉顶后底部零叠压，
   本条回 bottom:env(safe-area-inset-bottom) 贴屏幕底（只让 home indicator）——
   底部从此只有本输入条一个 fixed 元素，哥哥实测三次的「输入框被挡」从根上消灭；
   键盘弹起微信整体上移、贴键盘顶正常 */
.input-bar {
  position: fixed;
  left: 0; right: 0;
  bottom: env(safe-area-inset-bottom);   /* MP-TABBAR-TOP 定型：tabBar 在顶，底栏贴屏底 */
  display: flex;
  flex-direction: column;
  padding: 8px 12px;
  background: #FFFFFF;
  border-top: 1rpx solid #E5E5EA;
  z-index: 9998;
}
@media (prefers-color-scheme: dark) {
  .input-bar { background: #1C1C1E; border-top-color: #2C2C2E; }
}
.input-row { display: flex; align-items: center; }
.input {
  flex: 1;
  font-size: 14px;
  background: #F7F7F8;
  border-radius: 18px;
  padding: 8px 14px;
  color: var(--fg);
}
@media (prefers-color-scheme: dark) {
  .input { background: #2C2C2E; }
}
.send-btn {
  margin-left: 10px;
  font-size: 14px;
  font-weight: 600;
  color: #FFFFFF;
  background: #2563EB;
  border-radius: 18px;
  padding: 8px 16px;
}
.send-btn.off { opacity: 0.5; }

/* 横幅（实色双态） */
.banner-err {
  margin: 8px 12px;
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 12px;
  background: #FEE2E2;
  color: var(--err);
}
@media (prefers-color-scheme: dark) {
  .banner-err { background: #3B1517; }
}

.empty { text-align: center; color: var(--fg2); font-size: 13px; padding: 32px; }
