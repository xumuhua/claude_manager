/* pages/daily_report — MP-TABS-REPORT 日常报告页样式
   MP-UX7 红线：卡片/横幅/输入条背景一律实色 HEX + @media 双态，禁 var() 背景。 */
.page {
  min-height: 100vh;
  /* MP-TABBAR-EMBED（哥哥 10/8 令）：tabBar 位由全局 page 垫底（app.wxss）覆盖，
     此处只让位输入条（含私有群操作钮行 44+8 + 输入行 ≈48 + padding 16 ≈116px 上限，
     取 64px 常态值+尾部余量；多行/操作钮行场景消息列尾部允许再滑入垫区） */
  padding-bottom: 64px;
  box-sizing: border-box;
}

.sec-title { font-size: 13px; font-weight: 600; color: var(--fg2); margin: 14px 14px 2px; }

/* 报告卡片（status/experts 同款骨架） */
.card {
  margin: 10px 12px;
  border-radius: 10px;
  padding: 10px 12px;
  background: #F7F7F8;
}
@media (prefers-color-scheme: dark) {
  .card { background: #1C1C1E; }
}
.card-head { display: flex; align-items: center; margin-bottom: 4px; }
.fw-dot { font-size: 13px; margin-right: 6px; }
.card-name { font-size: 15px; font-weight: 600; margin-right: 8px; color: var(--fg); flex: 1; }
.card-toggle { font-size: 11px; color: var(--primary); }
.rpt-summary { font-size: 12px; color: var(--fg2); line-height: 1.7; white-space: pre-wrap; }
.rpt-none { font-size: 12px; color: var(--fg2); padding: 4px 0; }
.rpt-md { margin-top: 8px; border-top: 1rpx solid var(--divider); padding-top: 8px; }

/* 对话框 */
.chat-hint { font-size: 11px; color: var(--fg2); padding: 8px 16px; }
.chat-row { display: flex; padding: 4px 12px; }
.chat-row.me { justify-content: flex-end; }
.chat-bubble {
  max-width: 78%;
  border-radius: 10px;
  padding: 8px 12px;
  font-size: 14px;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  background: #F7F7F8;
  color: var(--fg);
}
.chat-bubble.user { background: #E0ECFF; }
@media (prefers-color-scheme: dark) {
  .chat-bubble { background: #1C1C1E; }
  .chat-bubble.user { background: #1E3A5F; }
}

/* 私有群操作钮行（返回/登出）：贴输入条上方，大按钮快速点击（哥哥 10/8 令） */
.pg-actions {
  display: flex;
  gap: 10px;
  padding: 0 0 8px;
}
.pg-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  font-size: 14px;
  font-weight: 600;
  border-radius: 10px;
  color: var(--primary);
  background: #E0ECFF;
}
.pg-action-btn.danger {
  color: #FFFFFF;
  background: #DC2626;
}
@media (prefers-color-scheme: dark) {
  .pg-action-btn { background: #1E3A5F; }
  .pg-action-btn.danger { background: #7F1D1D; }
}

/* 私有群消息（哥哥 10/8 二令②：自己的消息靠右含名字，别人的靠左） */
/* MP-TABBAR-TOP：tabBar 钉顶、input-bar 回贴屏幕底（底部零叠压）——
   可视高度只扣 input-bar+页头/底垫（172px），不再扣 tabBar 抬升量与环境安全区 */
.pg-scroll { height: calc(100vh - 172px); box-sizing: border-box; }
.pg-anchor { height: 1px; }
.pg-msg { display: flex; flex-direction: column; max-width: 85%; }
.pg-msg.mine { align-items: flex-end; }
.pg-from { font-size: 11px; color: var(--fg2); margin-bottom: 2px; }
.pg-body {
  font-size: 14px; line-height: 1.6; color: var(--fg);
  background: #F7F7F8; border-radius: 10px; padding: 8px 12px;
  white-space: pre-wrap; word-break: break-word;
}
.pg-msg.mine .pg-body { background: #E0ECFF; }
@media (prefers-color-scheme: dark) {
  .pg-body { background: #1C1C1E; }
  .pg-msg.mine .pg-body { background: #1E3A5F; }
}

/* 输入条（fixed 贴屏幕底；实色背景；column 向容纳私有群操作钮行+输入行）
   MP-TABBAR-TOP（哥哥 10/9 令，亦菲 seq 2692）：tabBar 钉顶后底部零叠压，
   本条回 bottom:env(safe-area-inset-bottom) 贴屏幕底（只让 home indicator）——
   底部从此只有本输入条一个 fixed 元素，哥哥实测三次的「输入框被挡」从根上消灭；
   键盘弹起微信整体上移、贴键盘顶正常 */
.input-bar {
  position: fixed;
  left: 0; right: 0;
  bottom: env(safe-area-inset-bottom);   /* MP-TABBAR-TOP 定型：tabBar 在顶，底栏贴屏底 */
  display: flex;
  flex-direction: column;
  padding: 8px 12px;
  background: #FFFFFF;
  border-top: 1rpx solid #E5E5EA;
  z-index: 9998;
}
@media (prefers-color-scheme: dark) {
  .input-bar { background: #1C1C1E; border-top-color: #2C2C2E; }
}
.input-row { display: flex; align-items: center; }
.input {
  flex: 1;
  font-size: 14px;
  background: #F7F7F8;
  border-radius: 18px;
  padding: 8px 14px;
  color: var(--fg);
}
@media (prefers-color-scheme: dark) {
  .input { background: #2C2C2E; }
}
.send-btn {
  margin-left: 10px;
  font-size: 14px;
  font-weight: 600;
  color: #FFFFFF;
  background: #2563EB;
  border-radius: 18px;
  padding: 8px 16px;
}
.send-btn.off { opacity: 0.5; }

/* 横幅（实色双态） */
.banner-err {
  margin: 8px 12px;
  padding: 6px 10px;
  border-radius: 8px;
  font-size: 12px;
  background: #FEE2E2;
  color: var(--err);
}
@media (prefers-color-scheme: dark) {
  .banner-err { background: #3B1517; }
}

.empty { text-align: center; color: var(--fg2); font-size: 13px; padding: 32px; }
