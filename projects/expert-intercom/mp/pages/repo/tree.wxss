.page { min-height: 100vh; }
/* MP-UX4：排序栏吸顶——sticky 钉在屏顶，不随列表滚动滚走；
   页面本身是文档流滚动（无 scroll-view），sticky 天然可用，不动 MP-UX2 布局 */
.sort-bar {
  position: sticky; top: 0; z-index: 50;
  display: flex; align-items: center;
  padding: 8px 16px; background: var(--bg);
  border-bottom: 1px solid var(--divider);
}
.sort-item { font-size: 13px; color: var(--fg2); padding: 4px 10px; border-radius: 6px; }
.sort-item.on { color: var(--primary); font-weight: 600; background: var(--bg2); }
.sort-sep { font-size: 12px; color: var(--divider); margin: 0 2px; }
.tree-list { margin: 8px 16px; background: var(--bg2); border-radius: 8px; overflow: hidden; }
.tree-row {
  display: flex; align-items: center; min-height: 48px; padding: 0 12px;
  border-bottom: 1px solid var(--divider);
}
.tree-row:last-child { border-bottom: none; }
.tree-icon { margin-right: 10px; }
.tree-name { flex: 1; font-size: 15px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.tree-name.binary { color: var(--fg2); }
.tree-size { font-size: 11px; color: var(--fg2); margin-left: 8px; }
/* MP-UX1：mtime 显示——与 size 同色调，略宽 margin 保持两列可读 */
.tree-mtime { font-size: 11px; color: var(--fg2); margin-left: 8px; white-space: nowrap; }
.tree-arrow { color: var(--fg2); margin-left: 8px; }
.empty { text-align: center; color: var(--fg2); font-size: 13px; margin-top: 60px; }
.error-box { margin: 80px 16px 0; text-align: center; }
.error-text { color: var(--fg2); font-size: 14px; }
.error-retry { color: var(--primary); font-size: 14px; margin-top: 12px; }

/* 分支切换条（2026-09-06） */
.branch-bar { display: flex; align-items: center; padding: 16rpx 24rpx; background: #f6f8fa; border-bottom: 1rpx solid #e5e8ec; }
.branch-label { margin-right: 12rpx; font-size: 28rpx; }
.branch-picker { flex: 1; }
.branch-current { font-size: 28rpx; color: #0969da; font-weight: 500; }
