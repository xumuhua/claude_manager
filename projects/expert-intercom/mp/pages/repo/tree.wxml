<view class="page">
  <view wx:if="{{loading}}">
    <view class="skel"></view><view class="skel"></view><view class="skel"></view>
    <view class="skel"></view><view class="skel"></view><view class="skel"></view>
  </view>

  <view wx:elif="{{error}}" class="error-box">
    <view class="error-text">{{error}}</view>
    <view class="error-retry" bindtap="loadTree">重试</view>
  </view>

  <block wx:else>
    <view wx:if="{{branches.length > 1}}" class="branch-bar">
      <text class="branch-label">🌿</text>
      <picker class="branch-picker" range="{{branches}}" value="{{branchIdx}}" bindchange="onBranchChange">
        <view class="branch-current">{{branch}} ▾</view>
      </picker>
    </view>
    <!-- MP-UX4：排序栏（吸顶，不随列表滚动）——默认按名称，选择存 storage -->
    <view class="sort-bar">
      <text class="sort-item {{sortMode === 'name' ? 'on' : ''}}" data-mode="name" bindtap="onSortChange">按名称</text>
      <text class="sort-sep">|</text>
      <text class="sort-item {{sortMode === 'mtime' ? 'on' : ''}}" data-mode="mtime" bindtap="onSortChange">按时间</text>
    </view>
    <view class="tree-list">
      <view wx:for="{{rows}}" wx:key="path" class="tree-row" data-row="{{item}}" bindtap="openRow">
        <text class="tree-icon">{{item.type === 'dir' ? '📂' : (item.isMd ? '📄' : '🖼')}}</text>
        <text class="tree-name {{item.type === 'file' && !item.isMd ? 'binary' : ''}}">{{item.name}}</text>
        <text wx:if="{{item.mtimeStr}}" class="tree-mtime">{{item.mtimeStr}}</text>
        <text wx:if="{{item.sizeStr}}" class="tree-size">{{item.sizeStr}}</text>
        <text wx:if="{{item.type === 'dir'}}" class="tree-arrow">›</text>
      </view>
    </view>
    <view wx:if="{{!rows.length}}" class="empty">空目录</view>
  </block>
</view>
