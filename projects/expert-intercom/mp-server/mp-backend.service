# mp-backend systemd unit（部署到备案域名服务器时使用）
[Unit]
Description=expert-intercom mp-backend (F5 小程序后端)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/expert-intercom/mp-backend
# 正式部署：hub token 与 mp token 一律走环境变量（env: 引用见 config.yaml），
# 真实值写入 /etc/systemd/system/mp-backend.service.d/override.conf 的 Environment= 行
Environment=INTERCOM_HUB_TOKEN_GEGE=__REPLACE_AT_DEPLOY__
Environment=MP_TOKEN_GEGE=__REPLACE_AT_DEPLOY__
ExecStart=/opt/expert-intercom/mp-backend/venv/bin/python server/app.py --config config.yaml --state /var/lib/expert-intercom/mp-backend-last_seq.state
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
