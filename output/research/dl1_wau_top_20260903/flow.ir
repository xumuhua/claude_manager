{
  "flow_ir_version": "v1-json-draft",
  "module_id": "wau_top",
  "layer_group": "L1",
  "stale": false,
  "desc": "wau_top L1 核心层 flow IR（§13.7 JSON+topo 形态；§14.3.3 层分组——本棒全部节点属 L1 骨架，group 字段承载层归属）。反提自 rtl/{wau_top,wau_split,wau_retbuf,wau_asm}.v，只覆盖 L1 数据通路/流水级/握手点；L2/L3 扩展点（trans 合并段/ready 寄存采样/sync 屏障段等）不载——彼属后续层增量反提。",
  "nodes": [
    {"id": "n_uop_in", "group": "L1", "kind": "port_in", "unit": "wau_top",
     "signals": ["ucb_wau_uop_valid", "wau_ucb_uop_ready", "ucb_wau_uop_info[41:0]", "ucb_wau_uop_mid[7:0]"],
     "note": "UOP 入口；uop_info 位域 {utype[1:0], base_addr[21:2], size[41:22]}"},
    {"id": "n_split_decode", "group": "L1", "kind": "stage", "unit": "wau_split",
     "stage": "S1-接受+几何", "pipeline_mode": "逐级握手",
     "function": "df_uop_accept + df_beat_geom（trans 公式段注记 L2 未实现）：uop 接受、beats_total 生成式（single=(size>0)?1:0 / multi=ceil(size/128) / trans=size / sync=0）、linear chunk 几何（chunk j 地址=(B-rot)+16j，bank=addr[8:4]，row=addr[18:9]）",
     "regs": ["rq_mem（请求 FIFO ×32 bank）", "disp_sel_q（轮换派发选择）"]},
    {"id": "n_bank_req", "group": "L1", "kind": "port_out", "unit": "wau_top",
     "signals": ["wau_bank_req_valid[31:0]", "wau_bank_req_addr[319:0]"],
     "note": "32 bank 请求口（bank 常通 ready——信用制防溢出，无 ready 反压）"},
    {"id": "n_mapfifo", "group": "L1", "kind": "stage", "unit": "wau_retbuf",
     "stage": "S1-映射登记", "pipeline_mode": "逐级握手",
     "function": "免 tag 对齐链：per-bank 映射 FIFO（请求接受拍推入 {line_seq, slot}，回数拍按 FIFO 序弹出落槽——映射 FIFO 序=回数序）；G125 容量口径=接受拍起算",
     "regs": ["map_mem/map_head_q/map_cnt_q ×32", "bm_* beat 元数据表 ×32 line", "occ_q 落槽位图 ×32 line（完成沿=聚合 occ_next 恰满差分判定）"]},
    {"id": "n_bank_ret", "group": "L1", "kind": "port_in", "unit": "wau_top",
     "signals": ["bank_wau_data_valid[31:0]", "bank_wau_data[4095:0]"],
     "note": "32 bank 回数口（无 ready——bank 侧只在请求后回数，L1 恒吞）"},
    {"id": "n_credit", "group": "L1", "kind": "stage", "unit": "wau_retbuf",
     "stage": "S1-信用闭环", "pipeline_mode": "无反压",
     "function": "df_credit_loop：在途 beat ≤ POOL(16)，请求发出受信用闸门（credit_q 计数：请求拍−1，回数落槽拍+1）",
     "regs": ["credit_q"]},
    {"id": "n_rack", "group": "L1", "kind": "stage", "unit": "wau_split",
     "stage": "S2-rack 收集", "pipeline_mode": "逐级握手",
     "function": "df_ret_collect（事件存续钉段注记 L3 未实现）：beat_done 按 mid 匹配 rack 表累加，读齐即发（Q-G）；rack_out 序=uop 接受序",
     "regs": ["rk_valid_q/rk_mid_q/rk_total_q/rk_done_q ×32"]},
    {"id": "n_rack_out", "group": "L1", "kind": "port_out", "unit": "wau_top",
     "signals": ["wau_rcb_rack_valid", "rcb_wau_rack_ready", "wau_rcb_uop_mid[7:0]"]},
    {"id": "n_asm", "group": "L1", "kind": "stage", "unit": "wau_asm",
     "stage": "S2-拼线出线", "pipeline_mode": "逐级握手",
     "function": "df_asm + df_rack_emit（sync 屏障段注记 L2 未实现）：保序 128B/拍出线（line_seq 序）；single 致密化 densify_abs 口径（偶组致密低半区/奇组高半区，strb=半区头部 n_lo/n_hi 连续位图——回挂前缀组不占 strb 位）；multi 线性移位 out[i]=win[i+rot]（G109 非循环）；trans 槽对合并段留 :L2-TRANS-ASM",
     "regs": ["head_q（出线指针）", "data_valid/data_out/data_strb 出口寄存器"],
     "comb": "128 路逐字节反查（致密/移位地址反推→head_flat 可变右移取字节）+ f 累加链 strb 计数（33 组上界，16 组×2 半区并行）"},
    {"id": "n_data_out", "group": "L1", "kind": "port_out", "unit": "wau_top",
     "signals": ["wau_dcb_data_valid", "dcb_wau_data_ready", "wau_dcb_data[1023:0]", "wau_dcb_data_strb[127:0]"],
     "note": "AXI 纪律寄存输出（FL_WAU_0301）；L3 c_ready_cut_data_out 未实现"}
  ],
  "edges": [
    {"from": "n_uop_in", "to": "n_split_decode", "kind": "handshake", "pair": "ucb_wau_uop_valid/wau_ucb_uop_ready"},
    {"from": "n_split_decode", "to": "n_bank_req", "kind": "dataflow", "via": "rq FIFO 派发（轮换 disp_sel）"},
    {"from": "n_split_decode", "to": "n_mapfifo", "kind": "dataflow", "via": "map_push{line_seq, slot}（请求接受拍）"},
    {"from": "n_bank_ret", "to": "n_mapfifo", "kind": "dataflow", "via": "bank_data_valid/bank_data（pop 落槽）"},
    {"from": "n_mapfifo", "to": "n_credit", "kind": "dataflow", "via": "落槽拍信用返还"},
    {"from": "n_mapfifo", "to": "n_rack", "kind": "dataflow", "via": "beat_done{mid}（line 完成沿）"},
    {"from": "n_mapfifo", "to": "n_asm", "kind": "dataflow", "via": "head_ready/head_flat[2047:0]/元数据读口（asm_line_seq）"},
    {"from": "n_rack", "to": "n_rack_out", "kind": "handshake", "pair": "wau_rcb_rack_valid/rcb_wau_rack_ready"},
    {"from": "n_asm", "to": "n_data_out", "kind": "handshake", "pair": "wau_dcb_data_valid/dcb_wau_data_ready",
     "note": "握手集中区=asm 出线握手区（load_c 判定/装填/head 推进一处）"}
  ],
  "handshake_points": [
    {"pair": "uop_valid/uop_ready", "stage": "S1", "fire": "uop_valid & uop_ready（QD 占位 + 几何管线首拍可吞）"},
    {"pair": "bank_req_valid[*]/(常通)", "stage": "S1", "fire": "disp_fire & 信用有剩（credit_q>0）"},
    {"pair": "bank_data_valid[*]/(恒吞)", "stage": "S1", "fire": "bank_data_valid 拍即落槽（pop_c）"},
    {"pair": "rack_valid/rack_ready", "stage": "S2", "fire": "rk_found_c & (rk 表首中优先链) & rack_ready"},
    {"pair": "data_valid/data_ready", "stage": "S2", "fire": "(~data_valid | fire) & head_ready 装填；data_valid & data_ready 腾空"}
  ],
  "pipeline_modes": {
    "逐级握手": ["uop_in→split", "retbuf→asm→data_out", "rack→rack_out"],
    "无反压": ["bank 请求口（信用制）", "bank 回数口（恒吞）", "retbuf 内部落槽/信用返还"]
  }
}
